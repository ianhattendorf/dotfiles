#!/bin/sh

set -eu

if [ "${DOTFILES_DRY_RUN:-0}" = "1" ]; then
  exit 0
fi

antidote_version="v2.1.0"
antidote_dir="${XDG_DATA_HOME:-$HOME/.local/share}/antidote"
antidote_ref="refs/tags/$antidote_version"

if [ ! -d "$antidote_dir/.git" ]; then
  mkdir -p "$(dirname "$antidote_dir")"
  git clone --depth 1 --branch "$antidote_version" \
    "https://github.com/mattmc3/antidote.git" \
    "$antidote_dir"
elif [ "$(git -C "$antidote_dir" rev-parse HEAD)" != \
  "$(git -C "$antidote_dir" rev-parse --verify "$antidote_ref^{}" 2>/dev/null || true)" ]; then
  git -C "$antidote_dir" fetch --force --depth 1 origin \
    "$antidote_ref:$antidote_ref"
  git -C "$antidote_dir" checkout --detach "$antidote_version"
else
  :
fi

if [ "$(uname)" = "Darwin" ]; then
  if command -v brew >/dev/null 2>&1; then
    if ! brew list bash >/dev/null 2>&1; then
      brew install bash
    fi
    nvm_version="v0.40.1"
    nvm_dir="$HOME/.config/nvm"
    nvm_installed_version=""
    if [ -s "$nvm_dir/nvm.sh" ]; then
      nvm_installed_version="v$(NVM_DIR="$nvm_dir" bash -c '. "$NVM_DIR/nvm.sh" >/dev/null && nvm --version' 2>/dev/null || true)"
    fi
    if [ "$nvm_installed_version" != "$nvm_version" ]; then
      NVM_DIR="$nvm_dir" PROFILE=/dev/null \
        bash -c "curl -fsSL 'https://raw.githubusercontent.com/nvm-sh/nvm/$nvm_version/install.sh' | bash"
    fi
    export NVM_DIR="$nvm_dir"
    set +u
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh"
    nvm install --lts
    nvm alias default 'lts/*'
    nvm_default_version="$(nvm version default)"
    if [ -n "$nvm_default_version" ] && [ "$nvm_default_version" != "N/A" ]; then
      ln -sfn "$NVM_DIR/versions/node/$nvm_default_version" "$NVM_DIR/current"
    fi
    corepack enable
    set -u
    if ! command -v rustup-init >/dev/null 2>&1 && ! command -v rustup >/dev/null 2>&1 && ! command -v cargo >/dev/null 2>&1; then
      brew install rustup
    fi
    if [ ! -x "$HOME/.cargo/bin/cargo" ] && command -v rustup-init >/dev/null 2>&1; then
      rustup-init -y --default-toolchain stable --no-modify-path
    fi
    brew_ruby_bin="$(brew --prefix ruby 2>/dev/null)/bin"
    if [ ! -x "$brew_ruby_bin/gem" ]; then
      brew install ruby
      brew_ruby_bin="$(brew --prefix ruby)/bin"
    fi
    [ -d "$brew_ruby_bin" ] && PATH="$brew_ruby_bin:$PATH"
    [ -d "$HOME/.cargo/bin" ] && PATH="$HOME/.cargo/bin:$PATH"
    export PATH
  else
    printf 'Homebrew is required to bootstrap cargo, gem, and npm on macOS\n' >&2
  fi
fi

if [ "$(uname)" != "Darwin" ]; then
  betterlockscreen_version="update-cache"
  betterlockscreen_url="https://github.com/ianhattendorf/betterlockscreen/archive/$betterlockscreen_version.tar.gz"
  betterlockscreen_dir="$HOME/bin"
  betterlockscreen_path="$betterlockscreen_dir/betterlockscreen"
  betterlockscreen_version_path="$betterlockscreen_path-$betterlockscreen_version"

  if [ ! -f "$betterlockscreen_version_path" ]; then
    mkdir -p "$betterlockscreen_dir"
    curl -L "$betterlockscreen_url" | tar xzv --strip-components=1 -C "$betterlockscreen_dir" "betterlockscreen-$betterlockscreen_version/betterlockscreen"
    mv "$betterlockscreen_dir/betterlockscreen" "$betterlockscreen_version_path"
    ln -s "$betterlockscreen_version_path" "$betterlockscreen_path"
  fi
fi

if ! command -v gem >/dev/null 2>&1; then
  printf 'RubyGems is required to install tmuxinator\n' >&2
  exit 1
fi

if ! gem list -i tmuxinator >/dev/null 2>&1; then
  gem install --user-install tmuxinator
fi

ensure_git_repo_at_commit() {
  repo_url="$1"
  repo_path="$2"
  repo_commit="$3"

  if [ ! -d "$repo_path/.git" ]; then
    mkdir -p "$(dirname "$repo_path")"
    git clone "$repo_url" "$repo_path"
  fi

  git -C "$repo_path" fetch --force origin "$repo_commit"
  git -C "$repo_path" checkout --detach "$repo_commit"
}

tmux_plugin_dir="$HOME/.tmux/plugins"
tmux_resurrect_commit="5cd69050218e5e142152ed52be421d58c39066ad"
tmux_continuum_commit="0698e8f4b17d6454c71bf5212895ec055c578da0"

ensure_git_repo_at_commit \
  "https://github.com/ianhattendorf/tmux-resurrect" \
  "$tmux_plugin_dir/tmux-resurrect" \
  "$tmux_resurrect_commit"

ensure_git_repo_at_commit \
  "https://github.com/tmux-plugins/tmux-continuum" \
  "$tmux_plugin_dir/tmux-continuum" \
  "$tmux_continuum_commit"

agent_status_commit="3ec9d69cf07d6c22e31970a8bc15675c2bec723b"

claude_status_line_commit="1edb04bafc9826aee0981cd3cddc4ba6375edc11"

waybar_modules_commit="3c6fa2a956364611417460344266b91e041ffe2f"

install_git_wt() {
  git_wt_version="v0.26.2"
  git_wt_base_url="https://github.com/k1LoW/git-wt/releases/download/$git_wt_version/git-wt_${git_wt_version}"
  git_wt_install_dir="$HOME/go/bin"

  _os="$(uname -s)"
  _arch="$(uname -m)"
  git_wt_url=""

  git_wt_archive_type=""

  case "${_os}_${_arch}" in
    Linux_x86_64|Linux_amd64)
      git_wt_url="${git_wt_base_url}_linux_amd64.tar.gz"
      git_wt_archive_type="tar"
      ;;
    Darwin_arm64)
      git_wt_url="${git_wt_base_url}_darwin_arm64.zip"
      git_wt_archive_type="zip"
      ;;
    Darwin_x86_64|Darwin_amd64)
      git_wt_url="${git_wt_base_url}_darwin_amd64.zip"
      git_wt_archive_type="zip"
      ;;
  esac

  if [ -n "$git_wt_url" ]; then
    git_wt_tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$git_wt_tmp_dir"' EXIT HUP INT TERM

    mkdir -p "$git_wt_install_dir"
    if [ "$git_wt_archive_type" = "zip" ]; then
      curl -L -o "$git_wt_tmp_dir/git-wt.zip" "$git_wt_url"
      unzip -q "$git_wt_tmp_dir/git-wt.zip" git-wt -d "$git_wt_tmp_dir"
    else
      curl -L "$git_wt_url" | tar xz -C "$git_wt_tmp_dir"
    fi
    install -m 0755 "$git_wt_tmp_dir/git-wt" "$git_wt_install_dir/git-wt"
  elif command -v go >/dev/null 2>&1; then
    mkdir -p "$git_wt_install_dir"
    GOBIN="$git_wt_install_dir" go install "github.com/k1LoW/git-wt@$git_wt_version"
  else
    printf 'go is required to install git-wt on this platform\n' >&2
  fi
}

install_git_wt

install_ssh_tpm_agent() {
  # ssh-tpm-agent is Linux-only (kernel keyring syscalls, TPM); skip elsewhere.
  [ "$(uname)" = "Linux" ] || return 0

  ssh_tpm_agent_commit="1a96091a3dddce53bbf74892229cdce570b3d047" # v0.8.0
  ssh_tpm_agent_install_dir="$HOME/go/bin"

  if command -v go >/dev/null 2>&1; then
    mkdir -p "$ssh_tpm_agent_install_dir"
    GOBIN="$ssh_tpm_agent_install_dir" go install "github.com/foxboron/ssh-tpm-agent/cmd/...@$ssh_tpm_agent_commit"
  else
    printf 'go is required to install ssh-tpm-agent\n' >&2
  fi
}

install_ssh_tpm_agent

if command -v cargo >/dev/null 2>&1; then
  cargo install --git "https://git.sr.ht/~ianhattendorf/agent-status" \
    --rev "$agent_status_commit"
  cargo install --git "https://git.sr.ht/~ianhattendorf/claude-status-line" \
    --rev "$claude_status_line_commit"
  if [ "$(uname)" != "Darwin" ]; then
    cargo install --git "https://git.sr.ht/~ianhattendorf/waybar-modules" \
      --rev "$waybar_modules_commit"
  fi

  cargo install emacs-lsp-booster
else
  printf 'cargo is required to build agent-status, claude-status-line, waybar-modules, and emacs-lsp-booster\n' >&2
fi

if command -v npm >/dev/null 2>&1; then
  npm install -g typescript-language-server typescript
else
  printf 'npm is required to install typescript-language-server\n' >&2
fi
