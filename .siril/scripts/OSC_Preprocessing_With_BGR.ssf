############################################
#
# Script for Siril 1.2
# February 2023
# (C) Cyril Richard
# Preprocessing v1.3
#
########### PREPROCESSING SCRIPT ###########
#
# Script for color camera preprocessing
#
# Needs 4 sets of RAW images in the working
# directory, within 4 directories:
#   biases/
#   flats/
#   darks/
#   lights/
# Saves masters to ./masters/
#
############################################

requires 1.2.0

# Convert Bias Frames to .fit files
cd biases
convert bias -out=../process
cd ../process

# FX -> DX crop
# (6048-3936)/2=1056
# (4024-2624)/2=700
seqcrop bias 1056 700 3936 2624

# Stack Bias Frames to bias_stacked.fit
stack cropped_bias rej 3 3 -nonorm -out=../masters/bias_stacked
cd ..

# Convert Flat Frames to .fit files
cd flats
convert flat -out=../process
cd ../process

# FX -> DX crop
# (6048-3936)/2=1056
# (4024-2624)/2=700
seqcrop flat 1056 700 3936 2624

# Calibrate Flat Frames
calibrate cropped_flat -bias=../masters/bias_stacked

# Stack Flat Frames to pp_flat_stacked.fit
stack pp_cropped_flat rej 3 3 -norm=mul -out=../masters/pp_flat_stacked
cd ..

# Convert Dark Frames to .fit files
cd darks
convert dark -out=../process
cd ../process

# FX -> DX crop
# (6048-3936)/2=1056
# (4024-2624)/2=700
seqcrop dark 1056 700 3936 2624

# Stack Dark Frames to dark_stacked.fit
stack cropped_dark rej 3 3 -nonorm -out=../masters/dark_stacked
cd ..

# Convert Light Frames to .fit files
cd lights
convert light -out=../process
cd ../process

# FX -> DX crop
# (6048-3936)/2=1056
# (4024-2624)/2=700
seqcrop light 1056 700 3936 2624

# Calibrate Light Frames
calibrate cropped_light -dark=../masters/dark_stacked -flat=../masters/pp_flat_stacked -cc=dark -cfa -equalize_cfa -debayer

# Per-sub gradient removal
seqsubsky pp_cropped_light 1

# Align lights
register bkg_pp_cropped_light

# Stack calibrated lights to result.fit
stack r_bkg_pp_cropped_light rej 3 3 -norm=addscale -output_norm -rgb_equal -out=result

# flip if required
load result
mirrorx -bottomup
save ../result_$LIVETIME:%d$s

cd ..
close