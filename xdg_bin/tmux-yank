#!/bin/sh
# Pipe tmux copy buffer to the system clipboard via OSC 52.
# Writes directly to the client TTY, bypassing tmux's terminal
# processing (which may re-encode OSC 52 with an ST terminator
# that mosh doesn't support).
tty=$(tmux display-message -p '#{client_tty}')
term=$(tmux display-message -p '#{client_termname}')
data=$(base64 | tr -d '\n')

case "$term" in
  tmux*|screen*)
    # Nested tmux: ask the outer tmux to pass the OSC 52 sequence through.
    printf '\033Ptmux;\033\033]52;c;%s\a\033\\' "$data" > "$tty"
    ;;
  *)
    printf '\033]52;c;%s\a' "$data" > "$tty"
    ;;
esac
