#!/bin/sh
#
# switch-mon - Switch external monitors to another machine's input (KVM-style)
#
# Resolves Sway output names to DDC/CI buses via sysfs, then sends the
# input-switch VCP command. Config is per-profile at ~/.config/switch-mon/config.
#
# Usage: switch-mon [<monitor-name>|all]
#   e.g.: switch-mon center
#         switch-mon right
#         switch-mon all       (default)

set -eu

config="${XDG_CONFIG_HOME:-$HOME/.config}/switch-mon/config"
if [ ! -f "$config" ]; then
  echo "error: no config at $config" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$config"

vcp_input='0x60'
choice="${1:-all}"

# Resolve a Sway output name (e.g. "DP-4") to a ddcutil i2c bus number
# by walking /sys/class/drm/card*-<output>/i2c-*
resolve_bus() {
  _output="$1"
  for _dir in /sys/class/drm/card*-"${_output}"/; do
    [ -d "$_dir" ] || continue
    for _i2c in "$_dir"/i2c-*; do
      [ -e "$_i2c" ] || continue
      basename "$_i2c" | cut -d- -f2
      return
    done
  done
  echo "error: no i2c bus found for output $_output" >&2
  return 1
}

switch_monitor() {
  _name="$1"
  eval "_sway_output=\${${_name}_output}"
  eval "_target_input=\${${_name}_input}"

  _bus=$(resolve_bus "$_sway_output") || return 1
  echo "Switching $_name ($_sway_output, bus $_bus) to input $_target_input"
  ddcutil --bus "$_bus" setvcp "$vcp_input" "$_target_input" || true
}

for _mon in $monitors; do
  if [ "$choice" = "$_mon" ] || [ "$choice" = "all" ]; then
    switch_monitor "$_mon"
  fi
done
