set $output_center DP-4
set $output_left eDP-2
set $output_right DP-3

output $output_left {
    bg '~/Pictures/wallpaper-1' fill #000000
    position 0,607
    adaptive_sync on
    resolution 2560x1600@165Hz
    scale 1.5
    subpixel rgb
}

output $output_center {
    bg '~/Pictures/wallpaper-2' fill #000000
    position 1706,0
    resolution 3840x2160@120Hz
    adaptive_sync on
    # render_bit_depth 10
    render_bit_depth 8
    scale 1.5
    subpixel rgb
}

output $output_right {
    bg '~/Pictures/wallpaper-portrait' fill #000000
    position 4266,0
    resolution 3840x2160@144Hz
    adaptive_sync on
    # render_bit_depth 10
    render_bit_depth 8
    scale 1.5
    subpixel rgb
}

workspace 1 output $output_center
workspace 2 output $output_right
workspace 3 output $output_center
workspace 4 output $output_left
workspace 5 output $output_center
workspace 6 output $output_center

exec swaymsg focus output $output_center
