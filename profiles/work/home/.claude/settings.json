{
  "cleanupPeriodDays": 9999,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git status:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git reflog:*)",
      "Bash(git describe:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git stash list:*)",
      "Bash(git stash show:*)",
      "Bash(git tag -l:*)",
      "Bash(git tag --list:*)",
      "Bash(git worktree list:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch -l:*)",
      "Bash(git branch -v:*)",
      "Bash(git branch -a:*)",
      "Bash(git branch -r:*)",
      "Bash(git config --get:*)",
      "Bash(git config --get-regexp:*)",
      "Bash(git config --get-all:*)",
      "Bash(git config --list:*)",
      "Bash(git remote -v:*)",
      "Bash(git remote get-url:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh search:*)",
      "Bash(gh label list:*)",
      "Bash(gh auth status:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(tree:*)",
      "Bash(which:*)",
      "Bash(command -v:*)",
      "Bash(command -V:*)",
      "Bash(type:*)",
      "Bash(man:*)",
      "Bash(readlink:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(pwd:*)",
      "mcp__vscode-inspector__*",
      "Read(~/dev/**)"
    ],
    "deny": [
      "Read(~/dev/certs/**)",
      "Read(~/dev/**/.env)",
      "Read(~/dev/**/.env.local)"
    ],
    "ask": [
      "Read(~/dev/**/*.pem)",
      "Read(~/dev/**/*.key)",
      "Read(~/dev/**/*.p12)",
      "Read(~/dev/**/*.pfx)",
      "Read(~/dev/**/id_rsa*)",
      "Read(~/dev/**/id_ed25519*)"
    ]
  },
  "hooks": {
    "CwdChanged": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PORT=$(cat ~/.insights/port 2>/dev/null || echo 3000); TOKEN=$(cat ~/.insights/token 2>/dev/null); curl -sf --max-time 2 -X POST http://127.0.0.1:$PORT/hooks/post-tool-use -H 'Content-Type: application/json' -H \"X-Insights-Token: $TOKEN\" --data-binary @- 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PORT=$(cat ~/.insights/port 2>/dev/null || echo 3000); TOKEN=$(cat ~/.insights/token 2>/dev/null); curl -sf --max-time 2 -X POST http://127.0.0.1:$PORT/hooks/post-tool-use-failure -H 'Content-Type: application/json' -H \"X-Insights-Token: $TOKEN\" --data-binary @- 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PORT=$(cat ~/.insights/port 2>/dev/null || echo 3000); TOKEN=$(cat ~/.insights/token 2>/dev/null); curl -sf --max-time 2 -X POST http://127.0.0.1:$PORT/hooks/pre-compact -H 'Content-Type: application/json' -H \"X-Insights-Token: $TOKEN\" --data-binary @- 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PORT=$(cat ~/.insights/port 2>/dev/null || echo 3000); TOKEN=$(cat ~/.insights/token 2>/dev/null); curl -sf --max-time 2 -X POST http://127.0.0.1:$PORT/hooks/pre-tool-use -H 'Content-Type: application/json' -H \"X-Insights-Token: $TOKEN\" --data-binary @- 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PORT=$(cat ~/.insights/port 2>/dev/null || echo 3000); TOKEN=$(cat ~/.insights/token 2>/dev/null); curl -sf --max-time 5 -X POST http://127.0.0.1:$PORT/hooks/session-end -H 'Content-Type: application/json' -H \"X-Insights-Token: $TOKEN\" --data-binary @- >/dev/null 2>/dev/null; [ -f ~/.insights/last-scorecard.txt ] && { cat ~/.insights/last-scorecard.txt > /dev/tty 2>/dev/null || cat ~/.insights/last-scorecard.txt; }; true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PORT=$(cat ~/.insights/port 2>/dev/null || echo 3000); TOKEN=$(cat ~/.insights/token 2>/dev/null); curl -sf --max-time 3 -X POST http://127.0.0.1:$PORT/hooks/session-start -H 'Content-Type: application/json' -H \"X-Insights-Token: $TOKEN\" --data-binary @- 2>/dev/null || echo '[insights] Insights Engine not running — session telemetry disabled.' >&2"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PORT=$(cat ~/.insights/port 2>/dev/null || echo 3000); TOKEN=$(cat ~/.insights/token 2>/dev/null); curl -sf --max-time 2 -X POST http://127.0.0.1:$PORT/hooks/stop -H 'Content-Type: application/json' -H \"X-Insights-Token: $TOKEN\" --data-binary @- 2>/dev/null || true"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PORT=$(cat ~/.insights/port 2>/dev/null || echo 3000); TOKEN=$(cat ~/.insights/token 2>/dev/null); curl -sf --max-time 2 -X POST http://127.0.0.1:$PORT/hooks/subagent-start -H 'Content-Type: application/json' -H \"X-Insights-Token: $TOKEN\" --data-binary @- 2>/dev/null || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PORT=$(cat ~/.insights/port 2>/dev/null || echo 3000); TOKEN=$(cat ~/.insights/token 2>/dev/null); curl -sf --max-time 2 -X POST http://127.0.0.1:$PORT/hooks/subagent-stop -H 'Content-Type: application/json' -H \"X-Insights-Token: $TOKEN\" --data-binary @- 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.cargo/bin/agent-status hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.cargo/bin/claude-status-line"
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "gk@gitkraken": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "gitkraken": {
      "source": {
        "source": "directory",
        "path": "/home/ian/.claude/plugins/marketplaces/gitkraken"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "git fetch *",
      "git pull *",
      "git push *",
      "git clone *",
      "git ls-remote *",
      "git remote update *",
      "git submodule update *",
      "git commit *",
      "git rebase *",
      "git merge *",
      "git cherry-pick *",
      "git tag *",
      "git revert *",
      "gh *",
      "pnpm *"
    ]
  },
  "effortLevel": "xhigh",
  "disableAutoMode": "disable",
  "theme": "auto",
  "autoCompactEnabled": false,
  "tui": "fullscreen"
}
