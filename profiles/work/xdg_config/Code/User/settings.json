{
	"editor.fontLigatures": true,
	"editor.fontFamily": "'Fira Code', 'Fira Mono', 'Droid Sans Mono', 'Courier New', monospace, 'Droid Sans Fallback'",
	"diffEditor.renderSideBySide": true,
	"editor.formatOnSave": true,
	"editor.formatOnType": true,
	"workbench.colorTheme": "Quiet Light",
	"editor.tabSize": 2,
	"redhat.telemetry.enabled": true,
	"todo-tree.regex.subTagRegex": "^\\((.*)\\)",
	"todo-tree.tree.buttons.groupBySubTag": true,
	"todo-tree.highlights.defaultHighlight": {
		"type": "tag-and-subTag",
	},
	"nrf-connect.topdir": "${nrf-connect.sdk:2.3.0-rc1}",
	"nrf-connect.toolchain.path": "PATH",
	"nrf-connect.enableTelemetry": true,
	"nrf-connect.welcome.showOnStartup": false,
	"devicetree.defaultBoard": "nrf5340dk_nrf5340",
	"mesonbuild.configureOnOpen": true,
	"window.zoomLevel": -1,
	"gitlens.outputLevel": "debug",
	"gitlens.ai.model": "gitkraken",
	"gitlens.ai.gitkraken.model": "gemini:gemini-2.0-flash",
	"gitlens.graph.experimentalFeatures.enabled": true,
	"task.allowAutomaticTasks": "on",
	"chat.viewSessions.orientation": "stacked",
	"gitlens.gitkraken.cli.integration.enabled": true,
	"gitlens.gitkraken.cli.insiders.enabled": true,
	"gitlens.graph.minimap.enabled": false,
	"claudeCode.preferredLocation": "panel",
	"gitlens.graph.experimental.useNewEngine": true,
	"gitlens.graph.details.location": "auto",
}
