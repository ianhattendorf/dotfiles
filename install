#!/usr/bin/env bash

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTBOT_DIR="vendor/dotbot"
DOTBOT_BIN="bin/dotbot"
CONFIG_DIR="${BASEDIR}/install.d"

PROFILE_LOCK="${BASEDIR}/.profile-lock"

profile="${DOTFILES_PROFILE:-}"
if [[ -z "${profile}" && -f "${PROFILE_LOCK}" ]]; then
  profile="$(cat "${PROFILE_LOCK}")"
fi

if [[ -n "${profile}" && "${profile}" != "base" ]]; then
  if [[ ! -f "${CONFIG_DIR}/profiles/${profile}.yaml" ]]; then
    printf 'Unknown DOTFILES_PROFILE: %s\n' "${profile}" >&2
    exit 1
  fi
else
  profile=""
fi

if [[ -n "${profile}" ]]; then
  if [[ -n "${DOTFILES_PROFILE:-}" ]]; then
    printf 'Profile: %s (from DOTFILES_PROFILE)\n' "${profile}"
  else
    printf 'Profile: %s (from %s)\n' "${profile}" "${PROFILE_LOCK}"
  fi
fi

config_paths=(
  "${CONFIG_DIR}/base/00-defaults.yaml"
  "${CONFIG_DIR}/base/10-clean.yaml"
  "${CONFIG_DIR}/base/20-home.yaml"
  "${CONFIG_DIR}/base/30-xdg-config.yaml"
  "${CONFIG_DIR}/base/40-xdg-data.yaml"
  "${CONFIG_DIR}/base/50-xdg-bin.yaml"
  "${CONFIG_DIR}/base/60-stateful.yaml"
  "${CONFIG_DIR}/base/70-bootstrap.yaml"
  "${CONFIG_DIR}/base/80-post-install.yaml"
)

chain=()
if [[ -n "${profile}" ]]; then
  seen=":"
  cur="${profile}"
  while [[ -n "${cur}" ]]; do
    yaml="${CONFIG_DIR}/profiles/${cur}.yaml"
    if [[ ! -f "${yaml}" ]]; then
      printf 'Unknown profile in chain: %s\n' "${cur}" >&2
      exit 1
    fi
    if [[ "${seen}" == *":${cur}:"* ]]; then
      printf 'Profile inheritance cycle at: %s\n' "${cur}" >&2
      exit 1
    fi
    seen="${seen}${cur}:"
    chain=("${cur}" "${chain[@]}")
    if [[ ${#chain[@]} -gt 8 ]]; then
      printf 'Profile chain too deep\n' >&2
      exit 1
    fi
    cur="$(sed -n '1s/^# parent: \([A-Za-z0-9_-]*\)$/\1/p' "${yaml}")"
  done
  for p in "${chain[@]}"; do
    config_paths+=("${CONFIG_DIR}/profiles/${p}.yaml")
  done
fi

dry_run=0
for arg in "$@"; do
  if [[ "${arg}" == "--dry-run" ]]; then
    dry_run=1
    break
  fi
done

tmp_config="$(mktemp)"
profile_filter=""
chain_paths=":"
if [[ ${#chain[@]} -gt 0 ]]; then
  profile_filter="$(mktemp)"
  for p in "${chain[@]}"; do
    sed -n 's/^\([[:space:]]*~\/[^:]*:\).*/\1/p' "${CONFIG_DIR}/profiles/${p}.yaml" >> "${profile_filter}"
    chain_paths="${chain_paths}${CONFIG_DIR}/profiles/${p}.yaml:"
  done
fi
cleanup() {
  rm -f "${tmp_config}" "${profile_filter:-}"
}
trap cleanup EXIT

for config_path in "${config_paths[@]}"; do
  if [[ -n "${profile_filter}" && -s "${profile_filter}" && "${chain_paths}" != *":${config_path}:"* ]]; then
    grep -vFf "${profile_filter}" "${config_path}" >> "${tmp_config}"
  else
    cat "${config_path}" >> "${tmp_config}"
  fi
  printf '\n' >> "${tmp_config}"
done

cd "${BASEDIR}"
git submodule update --init --recursive "${DOTBOT_DIR}"

DOTFILES_PROFILE="${profile}" \
DOTFILES_DRY_RUN="${dry_run}" \
"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${tmp_config}" "$@"

if [[ -n "${profile}" && "${dry_run}" -eq 0 ]]; then
  printf '%s\n' "${profile}" > "${PROFILE_LOCK}"
fi
